# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Senha para entrar no app pelo iPhone
APP_SENHA=escolha-uma-senha
# Texto aleatório e longo (assina o login)
SECRET_KEY=cole-aqui-um-texto-aleatorio-bem-longo

# Claude — https://platform.claude.com (API keys)
ANTHROPIC_API_KEY=
# Opcional: modelo usado para interpretar os gastos
# CLAUDE_MODEL=claude-opus-5-5

# Transcrição do áudio (Groq por padrão — https://console.groq.com)
TRANSCRICAO_API_KEY=
# Para usar a OpenAI em vez da Groq:
# TRANSCRICAO_BASE_URL=https://api.openai.com/v1
# TRANSCRICAO_MODELO=whisper-1

# Banco: em branco = SQLite local. Na nuvem, cole a URL do Postgres (Neon/Supabase).
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
